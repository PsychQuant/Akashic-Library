#!/bin/bash
# pre-push 把關（#與 CI 改制配套，2026-08-07）：CI 只在 push to main 跑一次
# （macOS runner 10× 計費，額度見 org billing），push 前的品質閘在本機。
#
# pipefail 是必要的（#129 verify 的教訓）：`swift test | tail` 這類管線會吞掉
# 測試程序的 exit code——crash 的 run 經管線回報 0。
set -eo pipefail

# Git 會把本次 push 的 repository-local 環境傳給 hook。若直接讓測試繼承，測試內
# 為 fixture 執行的 `git -C <temp>` 仍會被外層 GIT_DIR／GIT_INDEX_FILE 劫持，最壞
# 情況會把 fixture commit 寫回真正的 repository。先由 Git 自己列出完整 local env，
# 再逐一移除；PATH、credential 與一般程序環境不受影響。
git_local_env_vars="$(git rev-parse --local-env-vars)"
for git_local_env_var in $git_local_env_vars; do
    unset "$git_local_env_var"
done

echo "pre-push: swift build -Xswiftc -warnings-as-errors"
swift build -Xswiftc -warnings-as-errors

echo "pre-push: swift test -Xswiftc -warnings-as-errors（全套；判讀看最後一行總數——#56 的教訓）"
swift test -Xswiftc -warnings-as-errors

# **Plugin 守衛**（#407）。CI 的 macOS job 對 plugin-only 的 push 被
# paths-ignore 跳過（計費考量），所以本機這一關是它們唯一每次都會跑到的地方。
# 順序刻意放在 swift build 之後——parity 測試要拿建好的 CLI 當 oracle。
#
# 「進版控不等於會被執行」是 #407 R6 跨模型審查量到的缺口：五支守衛出貨了，
# 卻沒有任何自動觸發點（CI、hook、swift test、Makefile 全部零引用）。
echo "pre-push: plugin 守衛（覆蓋／散文／parity，各含 negative control）"
bash plugin/tests/rule-coverage.sh
python3 plugin/tests/rule-prose-guards.py --venue Sources/AkashicCore/Venue.swift
python3 plugin/tests/rule-prose-guards-mutations.py
bash plugin/skills/akashic-literal-campaign/scripts/tests/hash-table-drift.sh
bash plugin/skills/akashic-literal-campaign/scripts/tests/store-marker-parity.sh
python3 plugin/skills/akashic-literal-campaign/scripts/tests/marker-parity-mutations.py

echo "pre-push: ✓ 全部通過"
