#!/bin/bash
# pre-push 把關（#與 CI 改制配套，2026-08-07）：CI 只在 push to main 跑一次
# （macOS runner 10× 計費，額度見 org billing），push 前的品質閘在本機。
#
# pipefail 是必要的（#129 verify 的教訓）：`swift test | tail` 這類管線會吞掉
# 測試程序的 exit code——crash 的 run 經管線回報 0。
set -eo pipefail

# Git 會把本次 push 的 repository-local 環境傳給 hook。若直接讓測試繼承，測試內
# 為 fixture 執行的 `git -C <temp>` 仍會被外層 GIT_DIR／GIT_INDEX_FILE 劫持，最壞
# 情況會把 fixture commit 寫回真正的 repository。先由 Git 自己列出完整 local env，
# 再逐一移除；PATH、credential 與一般程序環境不受影響。
git_local_env_vars="$(git rev-parse --local-env-vars)"
for git_local_env_var in $git_local_env_vars; do
    unset "$git_local_env_var"
done

# **只推 tag 時跳過驗證**（#434）。
#
# git 從 stdin 餵 `<local ref> <local sha> <remote ref> <remote sha>`，一行一個 ref。
# tag 不改變任何檔案、不移動任何 branch——它給一個**已經在遠端的 commit** 一個名字。
# 對那樣的 push 跑完整驗證，驗的是一個遠端早就有的樹。
#
# **這不只是省時間，是防止 `--no-verify` 變成習慣**：CLAUDE.md 已記過「四分鐘的
# pre-push 在頻繁 push 時會被繞過，那時**所有**守衛等於不存在」。一個明顯無意義的
# 等待，是讓人開始習慣性繞過的最有效訓練——而繞過一旦成為肌肉記憶，它不會只用在
# tag 上。
#
# **「已經在遠端」是必要條件，不是裝飾**：`git push origin v1.0` 可以推一個指向
# **本地獨有** commit 的 tag，那次 push 會把那個 commit 一起帶上去。那時樹是新的，
# 驗證不能跳。
#
# stdin 為空（手動執行、或測試不餵）→ 什麼都不跳，照常跑完整流程。
if [ -t 0 ]; then
    push_refs=""            # 互動式終端機：沒有 git 餵的 ref，不要卡在 read 上
else
    push_refs="$(cat)"
fi
if [ -n "$push_refs" ]; then
    no_tree_only=1
    while read -r _local_ref local_sha remote_ref _remote_sha; do
        [ -z "$remote_ref" ] && continue
        # **刪除任何 ref 都不引入樹**（#530）。全零 local sha ＝ 刪除。
        #
        # 下面那個判斷本來就寫著「全零 sha ＝ 刪除該 ref。刪 tag 同樣不引入任何樹」
        # ——**但它被關在 `refs/tags/*` 分支裡面**，所以刪 branch 落到 `*)`、跑全套。
        # 而刪 branch 比刪 tag 更弱：tag 至少指向一個 commit（所以才需要「已在遠端」
        # 那道檢查），刪除則什麼都不指。
        #
        # 代價是量過的（2026-09-09 清理已合併 branch）：走 hook 的一批 20 支 **>600 秒**
        # 逾時；`--no-verify` 一批 30 支 ×4 共 115 支 **8 秒**。117 支照走要約 **15 小時**
        # 的測試，而那正是本檔上面那段註解在防的事——「一個明顯無意義的等待，是讓人
        # 開始習慣性繞過的最有效訓練」。
        if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
            continue                      # 刪除：不引入樹，這一個 ref 不構成「要驗證」
        fi
        case "$remote_ref" in
            refs/tags/*) ;;
            *) no_tree_only=0; break ;;
        esac
        # tag 指向的 commit 必須已被某個 remote-tracking branch 含著（推一個指向
        # 本地獨有 commit 的 tag，會把那個 commit 一起帶上去——那時樹是新的）。
        if ! git branch -r --contains "$local_sha" 2>/dev/null | grep -q .; then
            no_tree_only=0
            break
        fi
    done <<PUSH_REFS
$push_refs
PUSH_REFS
    if [ "$no_tree_only" = "1" ]; then
        echo "pre-push: 這次沒有引入任何樹（只有 tag／刪除 ref）——跳過驗證（#434／#530）"
        exit 0
    fi
fi

# **建置系統釘 native（#577，中間項）**。Xcode 27（2026-09-16）起 `swift` 6.4 預設走 swiftbuild，而
# `AkashicPropositionTests` 的三個外部探針以 .xctest 所在目錄反推 native 佈局的 `Modules/` 與
# `checkouts/Yams`，在 swiftbuild 下必紅；沒有環境變數可切回。swiftbuild 還會把 `.build/debug`
# 連結改指 `out/Products/Debug`、native 不會改回，而下方守衛從 `.build/debug/akashic-guards` 找
# binary——所以 build 之後把連結指回 native 的產物目錄。探針支援兩種佈局後這三行一起拿掉。
SWIFT_BUILD_SYSTEM=(--build-system native)
echo "pre-push: swift build --build-system native -Xswiftc -warnings-as-errors"
swift build "${SWIFT_BUILD_SYSTEM[@]}" -Xswiftc -warnings-as-errors

echo "pre-push: swift test --build-system native -Xswiftc -warnings-as-errors（全套；判讀看最後一行總數——#56 的教訓）"
swift test "${SWIFT_BUILD_SYSTEM[@]}" -Xswiftc -warnings-as-errors

# **Plugin 守衛**（#407）。CI 的 macOS job 對 plugin-only 的 push 被
# paths-ignore 跳過（計費考量），所以本機這一關是它們唯一每次都會跑到的地方。
# 順序刻意放在 swift build 之後——parity 測試要拿建好的 CLI 當 oracle。
#
# 「進版控不等於會被執行」是 #407 R6 跨模型審查量到的缺口：五支守衛出貨了，
# 卻沒有任何自動觸發點（CI、hook、swift test、Makefile 全部零引用）。
# **階段選擇**（#432）。預設跑全部——正常 `git push` 行為不變。
#
# `PrePushHookTests` 用 `AKASHIC_PRE_PUSH_STAGES=build,test` 只跑前兩階段:
# 它斷言的是「GIT_* 有沒有被清乾淨」與「swift 有沒有帶 -Xswiftc -warnings-as-errors」,
# **兩者都發生在前兩階段**,守衛對那兩個斷言毫無貢獻。而外層 hook 兩分鐘後會跑
# 同一批守衛、讀同一個工作樹、得同一個結果——內層那次是純浪費（實測 43 分鐘）。
#
# 這不是「測試模式」:它是「這一次要跑哪幾階段」,而測試只是第一個用到它的人。
case ",${AKASHIC_PRE_PUSH_STAGES:-build,test,guards}," in
  *,guards,*)
    # **只有守衛階段需要 `.build/debug` 指回 native 的產物**（`run-guards.sh` 從那裡找 akashic-guards）；build／test 兩階段自己帶
    # `--build-system native`，不讀連結。放在這裡而不是 build 之後，是因為 `PrePushHookTests` 以 repo root 為 cwd 跑前兩階段——
    # 重指是對工作樹的寫入，不該由跑一次 `swift test` 觸發（R20 verify regression 第 6 列）。
    # 重指失敗要出聲（R19 verify logic 第 30 列、regression 第 34 列）；`ln -sfn` 對**真目錄**不會取代、會在裡面建巢狀連結並回 0
    # （R20 verify security 第 13 列）——所以 ln 之後驗 readlink 真的等於目標，不等就中止。
    NATIVE_DEBUG="$(uname -m)-apple-macosx/debug"
    if [ ! -d ".build/$NATIVE_DEBUG" ]; then
      echo "✗ pre-push: 找不到 native 產物目錄 .build/$NATIVE_DEBUG——守衛會跑到別次建置的 binary，中止" >&2
      exit 1
    fi
    if [ -e .build/debug ] && [ ! -L .build/debug ]; then
      echo "✗ pre-push: .build/debug 不是符號連結（是真目錄或普通檔案），無法重指——對真目錄 ln -sfn 只會在裡面建巢狀連結；先移走它再推（R21 verify 第 26 列：不留巢狀連結；R22 verify 第 34 列：普通檔案也走這裡）" >&2
      exit 1
    fi
    ln -sfn "$NATIVE_DEBUG" .build/debug
    if [ "$(readlink .build/debug)" != "$NATIVE_DEBUG" ]; then
      echo "✗ pre-push: .build/debug 重指失敗（連結沒有指向 $NATIVE_DEBUG），中止" >&2
      exit 1
    fi
    echo "pre-push: plugin 守衛（覆蓋／散文／parity，各含 negative control）"
    bash "$(dirname "$0")/run-guards.sh"
    ;;
  *)
    echo "pre-push: （依 AKASHIC_PRE_PUSH_STAGES 略過守衛階段）"
    ;;
esac
echo "pre-push: ✓ 全部通過"
